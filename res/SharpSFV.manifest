  <assemblyIdentity type="win32" name="SharpSFV" version="2.7.0.0" processorArchitecture="*"/>
  <description>SharpSFV checksum utility (C++ port)</description>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
